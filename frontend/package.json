{
  "name": "qinghe-commerce-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5181 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests index.html vite.config.ts tsconfig.json package.json",
    "demo": "vite --mode prototype --host 127.0.0.1 --port 5182 --strictPort",
    "build:demo": "vue-tsc --noEmit && vite build --mode prototype --outDir dist-demo",
    "check:artifact": "node scripts/check-artifact.mjs",
    "verify": "npm run format:check && npm test && npm run build && npm run check:artifact"
  },
  "dependencies": {
    "@lucide/vue": "1.59.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
